    "cors": "2.8.5",
    "express": "5.2.1",
    "express-rate-limit": "8.2.1",
    "jose": "6.1.3",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/pg": "8.16.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "4.23.1",
    "vitest": "4.0.18"
