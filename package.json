{
  "name": "payl",
  "version": "0.1.0",
  "private": true,
  "description": "Antspace AI shopping and merchant commerce sandbox over MCP",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @payl/api --filter @payl/approval-web --filter @payl/merchant-web dev",
    "dev:api": "pnpm --filter @payl/api dev",
    "db:up": "docker compose up -d postgres",
    "db:test:up": "docker compose up -d --wait postgres-test",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @payl/api db:migrate",
    "demo": "pnpm --filter @payl/reference-agent demo",
    "auth:code": "pnpm --filter @payl/api auth:code",
    "deploy:secrets": "node scripts/generate-hosted-secrets.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm db:test:up && pnpm --filter @payl/api test",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
