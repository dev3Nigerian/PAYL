NODE_ENV=development
PAYL_DEPLOYMENT_PROFILE=local_sandbox
PORT=4100
DATABASE_URL=postgresql://payl:payl_dev_only@localhost:54329/payl
# Also set APPROVAL_WEB_URL on merchant-web and MERCHANT_WEB_URL on approval-web
# when using custom web origins. These are public URLs, never API credentials.
APPROVAL_WEB_URL=http://localhost:3000
MERCHANT_WEB_URL=http://localhost:3001
PUBLIC_BASE_URL=http://localhost:4100
PAYL_ISSUER=https://sandbox.payl.local
PAYL_DEV_KEYS=true
PAYL_SIGNING_KEY_ID=payl-hosted-sandbox-2026-01
SANDBOX_BOOTSTRAP_ENABLED=true
# Hosted sandbox only: base64-encoded 256-bit value from `pnpm deploy:secrets` or `openssl rand -base64 32`.
# PAYL_SIGNING_MASTER_KEY=
SANDBOX_QUOTE_TTL_MINUTES=60
SANDBOX_APPROVAL_TTL_MINUTES=45
SANDBOX_FULFILLMENT_TTL_MINUTES=60
LIFECYCLE_WORKER_INTERVAL_MS=2000
SANDBOX_CONSUMER_ID=consumer_demo
SANDBOX_MERCHANT_ID=merchant_demo
SANDBOX_CONSUMER_EMAIL=consumer@payl.local
SANDBOX_CONSUMER_PASSWORD=ConsumerDemo!2026
SANDBOX_CONSUMER_TOTP_SECRET=JBSWY3DPEHPK3PXP
SANDBOX_MERCHANT_EMAIL=merchant@payl.local
SANDBOX_MERCHANT_PASSWORD=MerchantDemo!2026
SESSION_TTL_HOURS=12
NEXT_PUBLIC_PAYL_API_URL=http://localhost:4100
PAYL_API_URL=http://localhost:4100
# Optional PayPal Sandbox rails. Configure all four values on the API only.
# PAYPAL_SANDBOX_CLIENT_ID=
# PAYPAL_SANDBOX_CLIENT_SECRET=
# PAYPAL_SANDBOX_MERCHANT_ID=
# PAYPAL_SANDBOX_WEBHOOK_ID=
# Optional in-app Shop with AI chat. Keep the key on the API service only.
# DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
